# Prisma Database Connection URLs
# Replace these with your actual Supabase / PostgreSQL credentials

# Transactional connection URL (for the app to connect at runtime via connection pool)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used ONLY for running migrations: npx prisma db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Auth/Session Management
# In production, use a strong random string (e.g., generated via 'openssl rand -base64 32')
JWT_SECRET="apparel-flow-erp-super-secret-key-change-in-production"
